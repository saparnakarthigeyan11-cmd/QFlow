# Copy this file to ".env.local" and fill in the values from:
# Firebase Console -> Project settings (gear icon) -> General -> Your apps -> QFlow -> SDK setup and configuration
# ".env.local" is ignored by Git. These web-config values are NOT secrets
# (they identify your project); your Firestore Security Rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qflow-8a7f2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qflow-8a7f2
VITE_FIREBASE_STORAGE_BUCKET=qflow-8a7f2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
